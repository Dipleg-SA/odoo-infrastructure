# --- Artefactos de macOS ---

.DS_Store

# --- Secrets y estado runtime ---
# Credenciales y estado que Docker genera/lee en runtime, nunca versionado.

secrets/
.env

# --- Workspace de VS Code ---
# Lo genera 'make dev-workspace' desde este mismo .env; local a cada checkout.

dev.code-workspace

# --- Clave de cuenta ACME ---
# Ya no se genera —certbot escribe en un volumen—, pero un checkout viejo la tiene.

acme.json

# --- Estado runtime ---
# Métricas y registro de addons que backup.sh deja; los directorios sí se versionan.

state/*
!state/textfile/
state/textfile/*
!state/textfile/.gitkeep
!state/meta/
state/meta/*
!state/meta/.gitkeep

# --- Config real de cada stack ---
# Archivos con valores de deployment (hostname, IP local, rate-limit, bucket de
# R2) escritos a mano; solo su .example se versiona. odoo.conf, grafana.ini y
# contact-points.yaml salieron de esta lista: desde que SMTP/alertas llegan por
# .env vía entrypoint/GF_*/provisioning, no les queda ningún valor por
# deployment — se versionan tal cual, sin .example.

stacks/nginx/config/00-http.conf
stacks/nginx/config/odoo.locations
stacks/nginx/config/server-tls.conf
stacks/postgres/config/postgresql.conf
stacks/dnsmasq/config/dnsmasq.conf
stacks/backup/config/r2.env

# --- Clones locales ---
# Repos externos clonados a mano para pruebas, no versionados.

repos/

# --- Addons ---
# Bind-mount desde el host. El manifiesto y los pines Python son locales a cada
# checkout —igual que .env, difieren de verdad entre dev/staging/producción— y no
# se versionan; solo sus plantillas y el esqueleto de categorías sí.

addons/*
!addons/addons.txt.example
!addons/requirements.txt.example
!addons/custom-addons/
addons/custom-addons/*
!addons/custom-addons/.gitkeep
!addons/oca/
addons/oca/*
!addons/oca/.gitkeep
!addons/third-party/
addons/third-party/*
!addons/third-party/.gitkeep
!addons/enterprise/
addons/enterprise/*
!addons/enterprise/.gitkeep

# Examples
.stacks
