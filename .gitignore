# --- Artefactos de macOS ---

.DS_Store

# --- Secrets y estado runtime ---
# Credenciales y estado que Docker genera/lee en runtime, nunca versionado.

secrets/
.env

# --- Datos por runtime ---
# Configuración, secretos y estado son privados; se conservan sus contratos de Compose.

runtime/desarrollo/*
!runtime/desarrollo/compose.yaml
!runtime/desarrollo/compose.env.example
runtime/staging/*
!runtime/staging/compose.yaml
!runtime/staging/compose.env.example
runtime/produccion/*
!runtime/produccion/compose.yaml
!runtime/produccion/compose.env.example

# --- Candidatos y control ---
# Catálogo y composición son plantillas versionadas; clones, candidatos y estado son mutables.

runtime/addons/*
!runtime/addons/catalogo.txt.example
!runtime/addons/requirements.txt.example
runtime/control/*
!runtime/control/compose.yaml

# --- Workspace de VS Code ---
# Lo genera 'make dev-workspace' desde este mismo .env; local a cada checkout.
# El nombre sale de COMPOSE_PROJECT_NAME (production.code-workspace,
# staging.code-workspace, development-<feature>.code-workspace), no es fijo.

*.code-workspace
.vscode/

# --- Clave de cuenta ACME ---
# Ya no se genera —certbot escribe en un volumen—, pero un checkout viejo la tiene.

acme.json

# --- Compatibilidad histórica de estado ---
# La operación actual usa runtime/<entorno>/state/. Estas reglas solo protegen datos
# de checkouts antiguos; no autorizan scripts ni procedimientos a usar state/.

state/*
!state/textfile/
state/textfile/*
!state/textfile/.gitkeep
!state/meta/
state/meta/*
!state/meta/.gitkeep

# --- Config real de cada stack ---
# Archivos con valores de deployment (hostname, IP local, rate-limit, bucket de
# R2) escritos a mano; solo su .example se versiona. odoo.conf, grafana.ini y
# contact-points.yaml salieron de esta lista: desde que SMTP/alertas llegan por
# .env vía entrypoint/GF_*/provisioning, no les queda ningún valor por
# deployment — se versionan tal cual, sin .example.

stacks/nginx/config/00-http.conf
stacks/nginx/config/odoo.locations
stacks/nginx/config/server-tls.conf
stacks/postgres/config/postgresql.conf
stacks/dnsmasq/config/dnsmasq.conf
stacks/backup/config/r2.env

# --- Clones locales ---
# Repos externos clonados a mano para pruebas, no versionados.

repos/

# Examples
.stacks
