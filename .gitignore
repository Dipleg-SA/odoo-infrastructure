# --- Artefactos de macOS ---

.DS_Store

# --- Secrets y estado runtime ---
# Credenciales y estado que Docker genera/lee en runtime, nunca versionado.

secrets/
.env

# --- Clave de cuenta ACME ---
# Ya no se genera —certbot escribe en un volumen—, pero un checkout viejo la tiene.

acme.json

# --- Estado runtime ---
# Métricas y registro de addons que backup.sh deja; los directorios sí se versionan.

state/*
!state/textfile/
state/textfile/*
!state/textfile/.gitkeep
!state/meta/
state/meta/*
!state/meta/.gitkeep

# --- Config real de nginx, dnsmasq, postgres y grafana ---
# Archivos con valores de deployment (hostname, IP local, rate-limit, stanza,
# bucket de R2, archive_mode, SMTP) escritos a mano; solo su .example se versiona.

docker/edge/nginx/00-http.conf
docker/edge/nginx/odoo.locations
docker/edge/nginx/server-tls.conf
docker/edge/dnsmasq/dnsmasq.conf
docker/db/postgres/pgbackrest.conf
docker/db/postgres/postgresql.conf
docker/observability/grafana/grafana.ini
docker/observability/grafana/provisioning/alerting/contact-points.yaml
docker/app/odoo/odoo.conf
docker/backups/r2.env

# --- Clones locales ---
# Repos externos clonados a mano para pruebas, no versionados.

repos/

# --- Addons ---
# Bind-mount desde el host. El manifiesto y los pines Python son locales a cada
# checkout —igual que .env, difieren de verdad entre dev/staging/producción— y no
# se versionan; solo sus plantillas y el esqueleto de categorías sí.

addons/*
!addons/addons.txt.example
!addons/requirements.txt.example
!addons/custom-addons/
addons/custom-addons/*
!addons/custom-addons/.gitkeep
!addons/oca/
addons/oca/*
!addons/oca/.gitkeep
!addons/third-party/
addons/third-party/*
!addons/third-party/.gitkeep
!addons/enterprise/
addons/enterprise/*
!addons/enterprise/.gitkeep

# Examples
.stacks
