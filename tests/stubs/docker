#!/usr/bin/env bash
# Stub de docker
# Cada comando requiere un fixture explícito en $STUB_DIR y nunca habla con un daemon.
#
# Fixtures: servicios, servicios-sin-perfil, config, ps-q, ps, port, imagenes,
# rmi y salida; un archivo vacío representa deliberadamente una respuesta vacía.
# servicios-sin-perfil puede reutilizar servicios cuando el caso no distingue perfiles.

printf '%s\n' "$*" >> "$STUB_DIR/llamadas"

# --services antes que config: la primera también contiene la palabra config.
# Y la consulta CON perfiles antes que la que no los lleva: son listas distintas
# —certbot y restore-* solo aparecen en la primera— y el caso puede fijar cada una.
case "$*" in
  *--profile*"config --services"*) archivo=servicios ;;
  *"config --services"*) archivo=servicios-sin-perfil ;;
  *config*)              archivo=config ;;
  *"ps -q"*)             archivo=ps-q ;;
  *" ps "*)              archivo=ps ;;
  *" port "*)            archivo=port ;;
  *"images -q"*)         archivo=imagenes ;;
  rmi*)                  archivo=rmi ;;
  *)                     archivo=salida ;;
esac

# El caso que no distingue perfiles fija un solo fixture: 'servicios' sirve para las dos.
if [ "$archivo" = servicios-sin-perfil ] && [ ! -f "$STUB_DIR/servicios-sin-perfil" ]; then
  archivo=servicios
fi

if [ ! -f "$STUB_DIR/$archivo" ]; then
  printf 'stub docker: falta fixture %s para: %s\n' "$archivo" "$*" >&2
  exit 99
fi
cat "$STUB_DIR/$archivo"

# Exit code: el global ($STUB_DIR/exit), o uno propio del subcomando si el caso lo
# preparó — hace falta para fallar UN paso de una secuencia y no la secuencia entera.
[ -f "$STUB_DIR/exit-$archivo" ] && exit "$(cat "$STUB_DIR/exit-$archivo")"
exit "$(cat "$STUB_DIR/exit" 2>/dev/null || echo 0)"
