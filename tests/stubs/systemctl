#!/usr/bin/env bash
# Stub de systemctl. Registra cada invocación con su nombre adelante —el de docker
# no lo lleva— y devuelve el fixture del caso; nunca habla con el init del host.

printf 'systemctl %s\n' "$*" >> "$STUB_DIR/llamadas"

[ -f "$STUB_DIR/systemctl" ] && cat "$STUB_DIR/systemctl"
exit "$(cat "$STUB_DIR/exit-systemctl" 2>/dev/null || echo 0)"
