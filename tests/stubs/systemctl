#!/usr/bin/env bash
# Stub de systemctl
# Cada invocación requiere el fixture systemctl y nunca habla con el init del host.
# Un archivo vacío representa deliberadamente una respuesta vacía.

printf 'systemctl %s\n' "$*" >> "$STUB_DIR/llamadas"

if [ ! -f "$STUB_DIR/systemctl" ]; then
  printf 'stub systemctl: falta fixture systemctl para: %s\n' "$*" >&2
  exit 99
fi
cat "$STUB_DIR/systemctl"
exit "$(cat "$STUB_DIR/exit-systemctl" 2>/dev/null || echo 0)"
