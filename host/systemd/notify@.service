# Plantilla de unidad
# timers.sh rellena ruta, entorno y nombre antes de instalarla.
# Parámetro de aviso
# OnFailure pasa el nombre de la unidad fallida mediante %i.

[Unit]
Description=Aviso de unit fallida (%i)

[Service]
Type=oneshot
WorkingDirectory=CAMBIAR-en-deploy
Environment=ENTORNO=CAMBIAR-entorno
ExecStart=CAMBIAR-en-deploy/scripts/failure-notify.sh %i
