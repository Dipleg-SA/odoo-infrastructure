# Identidad Compose
# Este nombre mantiene desarrollo separado de staging y producción.
COMPOSE_PROJECT_NAME=odoo-desarrollo

# Imagen Odoo
# Se reemplaza por la referencia Nueva validada antes de aplicar.
ODOO_IMAGE=local/odoo:19.0-desarrollo-bootstrap

# Rutas privadas de desarrollo
# Los stacks resuelven estas rutas desde sus propios archivos Compose.
RUNTIME_CONFIG_DIR=../../runtime/desarrollo/config
RUNTIME_SECRETS_DIR=../../runtime/desarrollo/secrets
RUNTIME_STATE_DIR=../../runtime/desarrollo/state

# Puerto y reportes internos
# El proxy queda en loopback y Odoo genera reportes por su red privada.
HTTP_PORT=8081
REPORT_URL=http://odoo:8069
