# Identidad Compose
# Este nombre mantiene staging separado de desarrollo y producción.
COMPOSE_PROJECT_NAME=odoo-staging
RUNTIME_ENVIRONMENT=staging

# Imagen Odoo
# make build la reemplaza por el tag construido para este entorno.
ODOO_IMAGE=local/odoo:19.0-staging-inicial

# Edición de Odoo
# La edición y el tag de release se validan juntos antes de operar el runtime.
ODOO_EDITION=community
TAG=19.0-ce-2026-09-16

# Rama de addons de staging
# El candidato integrado se consume sin crear ni sobrescribir referencias remotas.
ADDONS_REF=19.0-stag

# Rutas privadas de staging
# Los stacks resuelven estas rutas desde sus propios archivos Compose.
RUNTIME_CONFIG_DIR=../../runtime/staging/config
RUNTIME_SECRETS_DIR=../../runtime/staging/secrets
RUNTIME_STATE_DIR=../../runtime/staging/state
RUNTIME_ADDONS_DIR=../../runtime/staging/addons

# Acceso al proxy y reportes internos
# El proxy usa loopback para convivir con producción en el mismo host.
HTTP_PORT=8080
HTTPS_PORT=8443
REPORT_URL=http://odoo:8069
PUBLIC_HOSTNAME=

# Correo para avisos operativos
# Odoo no envía correo en staging; los valores se completan solo si hay alertas configuradas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
