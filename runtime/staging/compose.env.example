# Identidad Compose
# Este nombre mantiene staging separado de desarrollo y producción.
COMPOSE_PROJECT_NAME=odoo-staging

# Rutas privadas de staging
# Los stacks resuelven estas rutas desde sus propios archivos Compose.
RUNTIME_CONFIG_DIR=../../runtime/staging/config
RUNTIME_SECRETS_DIR=../../runtime/staging/secrets
RUNTIME_STATE_DIR=../../runtime/staging/state

# Acceso al proxy y reportes internos
# El proxy usa loopback para convivir con producción en el mismo host.
HTTP_PORT=8080
HTTPS_PORT=8443
REPORT_URL=http://odoo:8069
PUBLIC_HOSTNAME=

# Correo para avisos operativos
# Odoo no envía correo en staging; los valores se completan solo si hay alertas configuradas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
