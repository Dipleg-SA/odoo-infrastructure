# Identidad Compose
# Este nombre mantiene producción separada de desarrollo y staging.
COMPOSE_PROJECT_NAME=odoo-produccion

# Rutas privadas de producción
# Los stacks resuelven estas rutas desde sus propios archivos Compose.
RUNTIME_CONFIG_DIR=../../runtime/produccion/config
RUNTIME_SECRETS_DIR=../../runtime/produccion/secrets
RUNTIME_STATE_DIR=../../runtime/produccion/state

# Publicación del proxy y reportes internos
# LOCAL_IP vacío limita la publicación a loopback hasta que se configure el host.
LOCAL_IP=
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_HOSTNAME=
REPORT_URL=http://odoo:8069

# Perfil opcional de DNS local
# Descomentar el perfil solo cuando este host atienda una red LAN.
#COMPOSE_PROFILES=lan

# Correo saliente y avisos operativos
# Completar estos campos solo cuando el deployment tenga SMTP configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
