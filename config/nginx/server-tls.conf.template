# --- Server con TLS: producción y staging ---
# Se renderiza sobre conf.d/default.conf, que es el server de ejemplo de la
# imagen: escribirlo encima lo reemplaza en vez de convivir con él.
#
# El certificado tiene que existir ANTES del primer arranque — nginx no levanta
# con un ssl_certificate ausente. Lo emite certbot, que con DNS-01 no necesita
# que nginx esté vivo (ver INSTALL.md).

server {
  listen 80;
  listen [::]:80;
  server_name ${PUBLIC_HOSTNAME};

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${PUBLIC_HOSTNAME};

  ssl_certificate     /etc/letsencrypt/live/${PUBLIC_HOSTNAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOSTNAME}/privkey.pem;

  access_log /dev/stdout json_odoo;

  include /etc/nginx/conf.d/odoo.locations;
}
