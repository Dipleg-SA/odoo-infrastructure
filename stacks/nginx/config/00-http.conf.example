# --- Formato de log ---
# JSON a stdout: es la ÚNICA fuente de latencia y códigos de la capa de
# aplicación. Las alertas de Grafana lo consultan por LogQL contra Loki.

log_format json_odoo escape=json '{'
  '"time":"$time_iso8601",'
  '"route":"$route",'
  '"method":"$request_method",'
  '"uri":"$uri",'
  '"status":$status,'
  '"request_time":$request_time,'
  '"upstream_time":"$upstream_response_time",'
  '"bytes":$body_bytes_sent,'
  '"remote_addr":"$remote_addr"'
'}';

# --- Resolver de Docker ---
# Sin esto nginx resuelve los upstream una sola vez, al arrancar, y cachea la IP
# para siempre: si Odoo se recrea devuelve 502 hasta que alguien recargue nginx.
# valid=10s obliga a reconsultar; el proxy_pass por variable es la otra mitad.

resolver 127.0.0.11 valid=10s ipv6=off;

# --- Upgrade de websocket ---
# Connection tiene que ser "upgrade" solo cuando el cliente lo pide; fijarlo
# siempre rompe las peticiones normales, que esperan keep-alive.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# --- IP real del cliente ---
# Todo lo que entra por el túnel llega con la IP de cloudflared: sin esto, la
# zona de rate-limit es un solo bucket para todos y X-Real-IP le miente a Odoo.
# 172.16.0.0/12 cubre el pool de redes de Docker — cambialo si tu LAN cae ahí:
# un cliente podría forjar la cabecera.

set_real_ip_from 172.16.0.0/12;
real_ip_header CF-Connecting-IP;

# --- Rate-limit del login ---
# Zona por IP de origen. La ráfaga tolerada se aplica en odoo.locations, porque
# limit_req no acepta variables ahí. warn y no el error default: rechazar es el
# trabajo de la zona, no una avería.

limit_req_zone $binary_remote_addr zone=login:10m rate=2r/s;
limit_req_log_level warn;

# 429 y no el 503 que nginx devuelve por default: 503 es "servicio caído" y se
# confunde con una avería real, tanto en el dashboard como para el cliente que
# reintenta. 429 dice exactamente lo que pasó — demasiados intentos.

limit_req_status 429;
