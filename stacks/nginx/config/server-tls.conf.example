# --- Server con TLS: producción y staging ---
# Se monta como conf.d/default.conf, el server de ejemplo de la imagen:
# escribirlo encima lo reemplaza en vez de convivir con él.
#
# Reemplazá TU_DOMINIO por el hostname público real de este deployment, en
# las cuatro líneas de abajo. Es el mismo valor que PUBLIC_HOSTNAME en el
# .env de este checkout — lo necesitan dnsmasq y cert.sh, que no leen este
# archivo. make nginx-verify cruza los dos.
#
# El certificado tiene que existir ANTES del primer arranque — nginx no levanta
# con un ssl_certificate ausente. Lo emite certbot, que con DNS-01 no necesita
# que nginx esté vivo (ver docs/entorno/levantar-produccion.md).

# --- Redirección al hostname canónico ---
# $server_name y NO $host: $host devuelve lo que el cliente escribió y descarta el
# puerto, así que entrar por IP o por un puerto no estándar redirige a un destino
# donde el certificado no coincide o donde no escucha nadie. Se midió: por
# 127.0.0.1:8080, $host da https://127.0.0.1 (puerto 443, vacío) y $http_host da
# https://127.0.0.1:8080 (el puerto HTTP). $server_name da el hostname real.

server {
  listen 80;
  listen [::]:80;
  server_name TU_DOMINIO;

  return 301 https://$server_name$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name TU_DOMINIO;

  ssl_certificate     /etc/letsencrypt/live/TU_DOMINIO/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/TU_DOMINIO/privkey.pem;

  access_log /dev/stdout json_odoo;

  include /etc/nginx/conf.d/odoo.locations;
}
