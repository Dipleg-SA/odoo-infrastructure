# --- Repositorio de restic ---
# Va por env_file y no por el .env de raíz: es del stack, no del entorno, y no
# necesita que Compose lo interpole — lo lee el proceso de restic directamente.
#
# Reemplazá TU_ENDPOINT (sin esquema) y TU_BUCKET (sin barra final) por los
# valores reales. Un solo repositorio: acá va el dump de la base Y el filestore,
# en el mismo snapshot.

RESTIC_REPOSITORY=s3:https://TU_ENDPOINT/TU_BUCKET/restic
