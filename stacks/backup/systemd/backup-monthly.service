# Plantilla: `sudo make timers-install` inyecta la ruta del checkout y el prefijo
# del proyecto en el nombre. No se instala copiando este archivo a mano.
# Corre como root: necesita acceso al socket de Docker.

[Unit]
Description=Verificacion de integridad del repositorio de backups (restic check)
OnFailure=notify@%n.service
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=CAMBIAR-en-deploy
ExecStart=CAMBIAR-en-deploy/stacks/backup/scripts/backup.sh check
