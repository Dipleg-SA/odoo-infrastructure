# Plantilla de unidad
# timers.sh rellena ruta, entorno y nombre antes de instalarla.
# Permisos de ejecución
# Corre como root para acceder al socket Docker.

[Unit]
Description=Verificacion de integridad del repositorio de backups (restic check)
OnFailure=notify@%n.service
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=CAMBIAR-en-deploy
Environment=ENTORNO=CAMBIAR-entorno
ExecStart=CAMBIAR-en-deploy/stacks/backup/scripts/backup.sh check
