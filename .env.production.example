# Plantilla de PRODUCCIÓN: `cp .env.production.example .env` y completar antes de `make up`.
# Corto a propósito: casi todo lo configurable vive en el archivo de config de su
# herramienta, no acá. En un .env va solo lo que Compose necesita interpolar.
#
# No es el único config a bootstrapear: nginx, dnsmasq y postgres tienen su propio
# archivo real, con `cp` desde su .example (ver stacks/*/config/).

# --- Qué stack es este checkout ---
# Las dos que definen la identidad: el nombre gobierna contenedores, volúmenes,
# redes y tags de imagen; COMPOSE_FILE elige qué stacks se levantan. Ningún
# compose de stack declara `name:` — se declara acá. Si falta, Compose cae al
# directorio del compose elegido y dos checkouts comparten volúmenes en silencio.

COMPOSE_PROJECT_NAME=production
COMPOSE_FILE=envs/production.yaml

# --- Identidad de red de este deploy ---
# PUBLIC_HOSTNAME: dominio público real de este deploy. Es el mismo valor que va
#   literal en stacks/nginx/config/server-tls.conf y, si hay LAN, en
#   stacks/dnsmasq/config/dnsmasq.conf — esos archivos no leen este.
# LOCAL_IP: IP del servidor en la LAN, donde nginx publica 80 y 443.

PUBLIC_HOSTNAME=
LOCAL_IP=

# --- ¿Este cliente tiene servidor local? ---
# Descomentar SOLO si hay usuarios en la misma red que el servidor. Activa
# dnsmasq, que resuelve el hostname público a la IP local y evita que la LAN
# salga a internet para llegar a un servidor que tiene al lado.
#
# En un VPS no corresponde: no hay LAN, todos los usuarios son remotos y el
# tráfico entra por el túnel igual. Sin esta clave, dnsmasq no se levanta.

#COMPOSE_PROFILES=lan

# --- Rama de los repos de addons (opcional) ---
# Qué rama de cada repo del manifiesto materializa ESTE checkout. El default sale
# del tag `FROM odoo:` del Dockerfile, que es donde vive la versión de Odoo, así
# que producción no necesita declararlo.

#ADDONS_BRANCH=19.0

# --- Modo del proxy (opcional) ---
# tls es el default: nginx termina TLS con el certificado que emite certbot, y el
# 80 redirige al 443. plain queda como escape hatch, nada más.

#NGINX_MODE=plain

# --- Puertos del proxy (opcional) ---
# El bind es siempre ${LOCAL_IP} (nivel 3 del criterio de bind, fijo); esto es
# solo el puerto, por si el 80/443 de la LAN ya están ocupados por otra cosa.

#HTTP_PORT=8080
#HTTPS_PORT=8443

# --- Origen confiable, rate-limit del login (opcional) ---
# No son claves de este archivo: son set_real_ip_from y limit_req_zone/limit_req
# en stacks/nginx/config/{00-http.conf,odoo.locations}, reales por checkout.
# Editalos ahí directo si tu LAN cae en 172.16/12 o si el rate-limit da falsos positivos.
