# PRODUCCIÓN — `cp .env.production.example .env` y completar antes de `make up`.
#
# Acá va solo lo que Compose necesita interpolar. Todo lo demás vive en el config
# de su herramienta, bajo stacks/*/config/, y se bootstrapea aparte:
# ver docs/runbooks/entorno/levantar-produccion.md.

# --- Identidad del stack. ---
# Sin COMPOSE_PROJECT_NAME, dos checkouts comparten volúmenes.
COMPOSE_PROJECT_NAME=production
COMPOSE_FILE=envs/production.yaml

# Descomentar SOLO si hay usuarios en la misma red que el servidor: activa dnsmasq.
#COMPOSE_PROFILES=lan

# Dominio público real de este deploy.
PUBLIC_HOSTNAME=

# IP del servidor en la LAN, donde nginx publica 80 y 443.
LOCAL_IP=

# Rama de los repos de addons. El default sale del tag `FROM odoo:` del Dockerfile.
#ADDONS_BRANCH=19.0

# Puertos del proxy en LOCAL_IP. Obligatorios: los compose no traen default.
# No uses 8080/8443: son de prueba, que puede convivir en el mismo servidor.
HTTP_PORT=80
HTTPS_PORT=443

# Modo del proxy. tls es el default; plain es un escape hatch.
#NGINX_MODE=plain

# --- SMTP saliente y alertas por mail ---
# Un solo lugar para los tres que lo necesitan: odoo (lo appendea el entrypoint
# a odoo.conf), grafana (GF_SMTP_* pisa grafana.ini) y scripts/failure-notify.sh
# (dispara el OnFailure= de backup-daily, backup-monthly y cert-renew — sin
# estas cuatro claves, una corrida que falla a las 3am no avisa a nadie; make
# notify-test lo prueba de punta a punta). La credencial es la de siempre, en
# secrets/zeptomail_smtp_password — no se repite acá.
SMTP_HOST=smtp.zeptomail.com
SMTP_USER=
#SMTP_PORT=587

# Remitente y destinatario del aviso. ALERT_EMAIL_FROM es el mismo valor que
# configurar-zeptomail.md deja anotado; ALERT_EMAIL_TO no sale de ningún
# prerrequisito — es la casilla del operador que atiende los avisos.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=