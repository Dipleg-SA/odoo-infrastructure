# --- Repositorio de restic en R2 ---
# Lo usan backup y restore-files, vía env_file — no interpola desde el .env de
# raíz. pgBackRest tiene su propio bucket/endpoint en
# docker/db/postgres/pgbackrest.conf: puede ser el mismo bucket con otro
# prefijo, o uno propio.
#
# Reemplazá TU_ENDPOINT (sin esquema) y TU_BUCKET (sin barra final) por los
# valores reales.

RESTIC_REPOSITORY=s3:https://TU_ENDPOINT/TU_BUCKET/restic
