; --- Identidad del servidor ---
; root_url importa para los enlaces dentro de los mails de alerta; se llega por túnel SSH.

[server]
root_url = http://localhost:3000

; --- Credencial de admin ---
; $__file{} es la única forma de leer de archivo: Grafana NO soporta sufijo __FILE en env vars.

[security]
admin_user = admin
admin_password = $__file{/run/secrets/grafana_admin_password}

; --- Anonimato y registro ---
; Operador único: sin registro, sin usuarios anónimos.

[users]
allow_sign_up = false

; --- SMTP ---
; Reusa el secret de ZeptoMail de la capa correspondiente, sin duplicar la credencial.
; Reemplazá TU_SMTP_HOST, TU_SMTP_PORT, TU_SMTP_USER y TU_EMAIL_ALERTA_FROM por
; los mismos valores que SMTP_HOST/SMTP_PORT/SMTP_USER/ALERT_EMAIL_FROM en el
; .env de este checkout — los necesita odoo y failure-notify.sh, que no leen
; este archivo.

[smtp]
enabled      = true
password     = $__file{/run/secrets/zeptomail_smtp_password}
from_name    = Grafana - infra Odoo
host         = TU_SMTP_HOST:TU_SMTP_PORT
user         = TU_SMTP_USER
from_address = TU_EMAIL_ALERTA_FROM
