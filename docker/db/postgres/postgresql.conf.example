# --- Paths (montado fuera de PGDATA vía config_file=, hay que fijarlos de vuelta) ---

data_directory = '/var/lib/postgresql/data'
hba_file       = '/var/lib/postgresql/data/pg_hba.conf'
ident_file     = '/var/lib/postgresql/data/pg_ident.conf'

# --- Red ---

listen_addresses = '*'

# --- Tuning ---
# Ratios sobre el mem_limit del contenedor, no sobre la RAM del host: Odoo es el
# inquilino principal y a Postgres se lo acota. Recalibrar si cambia ese cap.

shared_buffers        = 512MB
effective_cache_size  = 1536MB
work_mem              = 16MB
maintenance_work_mem  = 256MB
max_connections       = 100

# --- WAL / archivado (pgBackRest) ---
# Sin --stanza: con una sola sección de stanza en pgbackrest.conf, pgBackRest
# la autodetecta.
#
# archive_mode: on en producción, off en staging/development — NO es opcional
# en los dos últimos. Un stack sin la capa de backups apunta igual a la stanza
# de producción para restaurar: con el archivado prendido le empuja su propio
# WAL y contamina el repositorio real. make db-verify lo exige según las capas
# del stack.

archive_command = 'pgbackrest archive-push %p'
archive_timeout = 300
archive_mode    = on
