# Config real de pgBackRest para este checkout. Las claves de R2 y la
# passphrase de cifrado llegan aparte, por el secret montado en
# /etc/pgbackrest/conf.d/r2.conf. Los comentarios van con '#': pgBackRest no
# acepta ';' (a diferencia de PgBouncer).
#
# Reemplazá TU_STANZA, TU_BUCKET y TU_ENDPOINT por los valores reales. El
# nombre de la stanza no hace falta repetirlo en ningún otro lado: con una
# sola sección de stanza en este archivo, pgBackRest la autodetecta —lo
# probamos contra el binario real antes de asumirlo.

[global]

# --- Repositorio (Cloudflare R2, S3-compatible) ---

repo1-type         = s3
repo1-path         = /pgbackrest
repo1-s3-region    = auto
repo1-s3-uri-style = path
repo1-s3-bucket    = TU_BUCKET
repo1-s3-endpoint  = TU_ENDPOINT

# --- Cifrado ---
# Se fija al crear la stanza: cambiarlo después obliga a recrear el repo entero.

repo1-cipher-type = aes-256-cbc

# --- Retención ---
# Fija, no por deployment: pareja con KEEP_DAILY/WEEKLY/MONTHLY de
# scripts/backup.sh — la cobertura de restic tiene que caber acá adentro.

repo1-retention-full-type = time
repo1-retention-full      = 125

# --- Bundling ---
# Agrupa los miles de archivos chicos del cluster: contra R2 manda la latencia por objeto.

repo1-bundle = y

# --- Proceso y logs ---
# process-max acotado a los cpus del contenedor (2.0) para no competir con la base.

process-max       = 2
log-level-console = info
log-level-file    = detail
log-path          = /var/log/pgbackrest

[TU_STANZA]
pg1-path = /var/lib/postgresql/data
pg1-user = odoo
