# Plantilla de STAGING: `cp .env.stag.example .env` y completar antes de `make up`.
# Sus 8 secrets y sus capas salen de COMPOSE_FILE: sin backups, sin observabilidad y
# sin dnsmasq. Lo que esas capas necesitarían —alertas, retenciones, forwarders— no
# está en este archivo, y esa ausencia es deliberada: 'make host-verify' marca las
# claves vacías, así que declararlas en blanco sería peor que no tenerlas.

# --- Qué stack es este checkout ---
# El nombre gobierna contenedores, volúmenes, redes y tags de imagen: tiene que ser
# distinto al de producción o los dos stacks se pisan. COMPOSE_FILE elige las capas.

COMPOSE_PROJECT_NAME=staging
COMPOSE_FILE=compose.staging.yaml

# --- Archivado de WAL: APAGADO, y no es opcional ---
# Staging apunta a la stanza de producción para poder restaurar. Con el archivado
# prendido le empuja su propio WAL al repositorio del entorno real y lo contamina
# desde el entorno que existe para romper cosas. 'make db-verify' lo exige en off.

PG_ARCHIVE_MODE=off

# --- Identidad de red de este deploy ---
# PUBLIC_HOSTNAME: dominio público real de staging (ver INSTALL.md). No lleva
# LOCAL_IP: no publica ningún puerto —el ingreso entra por el túnel— y el :80 de la
# LAN ya lo tiene producción.

PUBLIC_HOSTNAME=

# --- Repositorio de backups: los valores de PRODUCCIÓN ---
# Staging no respalda; lee. Es el repositorio de producción el que se restaura, así
# que estas tres son las mismas que en el .env de producción, letra por letra.
# El secret con las credenciales de R2 también es el de producción.

R2_ENDPOINT=
R2_BUCKET=
PGBACKREST_STANZA=

# --- Rama de los repos de addons ---
# Qué rama de cada repo del manifiesto materializa este checkout. 'make odoo-verify'
# exige que sea la versión de la imagen o un sufijo suyo.

ADDONS_BRANCH=19.0-stag

# --- Presupuesto de memoria (opcional) ---
# Los dos servicios que escalan con el uso. Un staging convive con producción en el
# mismo servidor: bajarlos es lo primero que hay que mirar si la RAM aprieta.

#ODOO_MEM_LIMIT=5g
#POSTGRES_MEM_LIMIT=2g

# --- Modo del proxy (opcional) ---
# tls es el default: nginx termina TLS con el certificado que emite certbot, y el
# 80 redirige al 443. plain queda como escape hatch, nada más.

#NGINX_MODE=plain

# --- Propagación del desafío DNS-01 (opcional) ---
# Cuánto espera certbot a que el registro TXT propague antes de pedirle a la CA
# que valide. Subilo si la emisión falla por validación en una zona lenta.

#ACME_PROPAGATION_SECONDS=30

# --- Origen confiable para la IP real (opcional) ---
# De dónde le llega a nginx el tráfico de cloudflared: solo a ese rango se le
# cree la cabecera CF-Connecting-IP. El default cubre el pool de redes de Docker.

#PROXY_TRUSTED_CIDR=172.16.0.0/12

# --- Rate-limit del login (opcional) ---
# Requests por segundo y ráfaga tolerada antes de cortar.

#LOGIN_RATE_AVERAGE=2
#LOGIN_RATE_BURST=10
