# Plantilla de STAGING: `cp .env.stag.example .env` y completar antes de `make up`.
# Sus 8 secrets y sus capas salen de COMPOSE_FILE: sin backups, sin observabilidad y
# sin dnsmasq. Lo que esas capas necesitarían —alertas, retenciones, forwarders— no
# está en este archivo, y esa ausencia es deliberada: 'make host-verify' marca las
# claves vacías, así que declararlas en blanco sería peor que no tenerlas.

# --- Qué stack es este checkout ---
# El nombre gobierna contenedores, volúmenes, redes y tags de imagen: tiene que ser
# distinto al de producción o los dos stacks se pisan. COMPOSE_FILE elige las capas.

COMPOSE_PROJECT_NAME=staging
COMPOSE_FILE=docker/compose.staging.yaml

# --- Archivado de WAL: APAGADO, y no es opcional ---
# NO es una clave de este archivo: es `archive_mode = off` en
# docker/db/postgres/postgresql.conf de ESTE checkout (bootstrapeado desde su
# .example, gitignoreado). Staging apunta a la stanza de producción para poder
# restaurar. Con el archivado prendido le empuja su propio WAL al repositorio
# del entorno real y lo contamina desde el entorno que existe para romper
# cosas. 'make db-verify' lo exige en off.

# --- Identidad de red de este deploy ---
# PUBLIC_HOSTNAME: dominio público real de staging (ver INSTALL.md). No lleva
# LOCAL_IP: no publica ningún puerto —el ingreso entra por el túnel— y el :80 de la
# LAN ya lo tiene producción.

PUBLIC_HOSTNAME=

# --- Repositorio de restic: los valores de PRODUCCIÓN ---
# No son claves de este archivo: es RESTIC_REPOSITORY en docker/backups/r2.env
# (gitignoreado, bootstrapeado desde su .example) — el mismo repositorio de
# producción, letra por letra, porque staging no respalda, lee. El secret con
# las credenciales de R2 también es el de producción. La stanza y el bucket de
# pgBackRest van aparte, en docker/db/postgres/pgbackrest.conf — también con
# los valores de producción.

# --- Rama de los repos de addons ---
# Qué rama de cada repo del manifiesto materializa este checkout. 'make odoo-verify'
# exige que sea la versión de la imagen o un sufijo suyo.

ADDONS_BRANCH=19.0-stag

# --- Presupuesto de memoria ---
# No son claves de este archivo: son mem_limit en docker/app/odoo/compose.yaml
# y docker/db/postgres/compose.yaml, fijos. Un staging convive con producción en
# el mismo servidor: bajarlos ahí directo es lo primero que hay que mirar si la RAM aprieta.

# --- Modo del proxy (opcional) ---
# tls es el default: nginx termina TLS con el certificado que emite certbot, y el
# 80 redirige al 443. plain queda como escape hatch, nada más.

#NGINX_MODE=plain

# --- Origen confiable, rate-limit del login (opcional) ---
# No son claves de este archivo: son set_real_ip_from y limit_req_zone/limit_req
# en docker/edge/nginx/00-http.conf y odoo.locations, real por checkout.
