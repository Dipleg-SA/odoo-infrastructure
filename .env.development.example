# DEVELOPMENT — `cp .env.development.example .env` y completar antes de `make up`.
#
# El más corto de los tres: tres stacks y dos secrets, los dos generados por
# `make secrets-init`. No hay ningún valor que pegar a mano.
# Ver docs/runbooks/entorno/levantar-desarrollo.md.

# Identidad del stack. ÚNICO POR CHECKOUT: de él salen los volúmenes.
COMPOSE_PROJECT_NAME=development-<feature>
COMPOSE_FILE=envs/development.yaml

# Puerto del proxy en loopback. Obligatorio: los compose no traen default.
# El 8080 es de prueba, que puede convivir en el mismo host.
HTTP_PORT=8081

# Rama de feature que este checkout materializa.
ADDONS_BRANCH=feat/mi-feature
