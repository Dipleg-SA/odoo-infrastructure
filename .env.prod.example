# Plantilla de PRODUCCIÓN: `cp .env.prod.example .env` y completar antes de `make up`.
# Hay una plantilla por entorno —.env.stag.example y .env.dev.example—, cada una con
# las claves de sus capas y nada más: no hay que borrar bloques de un archivo genérico.
# No es el único config no versionado: nginx, dnsmasq y postgres/pgBackRest tienen
# su propio archivo real, bootstrapeado con cp desde su .example (ver docker/).

# --- Qué stack es este checkout ---
# Las dos que definen la identidad: el nombre gobierna contenedores, volúmenes,
# redes y tags de imagen; COMPOSE_FILE elige qué capas se levantan. Ningún
# compose de capa declara `name:` — se declara acá. Si falta, Compose cae al
# directorio del compose elegido: el stack pasa a llamarse 'docker', como cualquier otro.

COMPOSE_PROJECT_NAME=production
COMPOSE_FILE=docker/compose.yaml

# --- Identidad de red de este deploy ---
# PUBLIC_HOSTNAME: dominio público real de este deploy (ver INSTALL.md).
# LOCAL_IP: IP del servidor en la LAN, donde nginx publica 80 y 443.

PUBLIC_HOSTNAME=
LOCAL_IP=

# --- Repositorio de restic ---
# No son claves de este archivo: es RESTIC_REPOSITORY en docker/backups/r2.env
# (gitignoreado, bootstrapeado desde su .example) — lo usan backup y
# restore-files vía env_file, sin interpolar desde acá.

# --- SMTP y alertas ---
# Compartido por Odoo y failure-notify.sh; la contraseña es un secret, no va acá.
# Grafana NO lee estas claves: tiene su propia copia literal en grafana.ini y
# contact-points.yaml (reales por checkout, ver docker/observability/grafana/)
# — los mismos valores, escritos ahí a mano.
#
# SMTP_HOST / SMTP_PORT: host y puerto del proveedor transaccional. Los consume
#   Odoo, vía el entrypoint, y failure-notify.sh.
# SMTP_USER: usuario SMTP del proveedor — no siempre es una dirección de correo.
# ALERT_EMAIL_FROM: remitente verificado en el proveedor (uno no verificado se rechaza).
# ALERT_EMAIL_TO: a dónde failure-notify.sh manda el aviso de backup fallido.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Presupuesto de memoria ---
# No son claves de este archivo: son mem_limit en docker/app/odoo/compose.yaml
# (5g) y docker/db/postgres/compose.yaml (2g), fijos. Bajalos ahí directo en un
# servidor chico.

# --- Rama de los repos de addons (opcional) ---
# Qué rama de cada repo del manifiesto materializa ESTE checkout. El default sale
# del tag `FROM odoo:` del Dockerfile, que es donde vive la versión de Odoo, así
# que producción no necesita declararlo.

#ADDONS_BRANCH=19.0

# --- Modo del proxy (opcional) ---
# tls es el default: nginx termina TLS con el certificado que emite certbot, y el
# 80 redirige al 443. plain queda como escape hatch, nada más.

#NGINX_MODE=plain

# --- Puertos del proxy (opcional) ---
# El bind es siempre ${LOCAL_IP} (nivel 3 del criterio de bind, fijo); esto es
# solo el puerto, por si el 80/443 de la LAN ya están ocupados por otra cosa.

#HTTP_PORT=8080
#HTTPS_PORT=8443

# --- Origen confiable, rate-limit del login (opcional) ---
# No son claves de este archivo: son set_real_ip_from y limit_req_zone/limit_req
# en docker/edge/nginx/00-http.conf y odoo.locations, real por checkout. Editalos
# ahí directo si tu LAN cae en 172.16/12 o si el rate-limit da falsos positivos.
