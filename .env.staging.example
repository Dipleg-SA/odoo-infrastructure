# Plantilla de PRUEBA: `cp .env.staging.example .env` y completar antes de `make up`.
# Corto a propósito: casi todo lo configurable vive en el archivo de config de su
# herramienta. En un .env va solo lo que Compose necesita interpolar.

# --- Qué stack es este checkout ---
# El nombre gobierna contenedores, volúmenes, redes y tags de imagen: tiene que ser
# distinto al de producción o los dos stacks se pisan en el mismo servidor.

COMPOSE_PROJECT_NAME=staging
COMPOSE_FILE=envs/staging.yaml

# --- Identidad de red de este deploy ---
# El hostname propio de prueba, distinto al de producción. NO lleva LOCAL_IP: este
# entorno no publica ningún puerto —el ingreso entra por el túnel— y el :80 y el
# :443 de la LAN ya los tiene producción.
#
# Es el mismo valor que va literal en stacks/nginx/config/server-tls.conf, que no
# lee este archivo.

PUBLIC_HOSTNAME=

# --- Sin COMPOSE_PROFILES ---
# NO declarar esta clave. Prueba no lleva dnsmasq: corre sobre el 53 con el stack
# de red del host y no admite una segunda instancia. Copiar el .env de producción
# con COMPOSE_PROFILES=lan es la forma de romperlo.

# --- El repositorio de restic es el DE PRODUCCIÓN ---
# No es una clave de este archivo: es RESTIC_REPOSITORY en
# stacks/backup/config/r2.env, y va con el valor de producción letra por letra.
# Prueba no respalda: LEE de ahí para sembrarse.
#
# Y la credencial de R2 de este checkout tiene que ser DE SOLO LECTURA. Es la
# segunda capa de la garantía: la primera es estructural —el entrypoint le pone
# profiles: [restore] al servicio, así que los timers de backup no se instalan—,
# y esta cubre el caso de que alguien corra el script a mano.

# --- Rama de los repos de addons ---
# Qué rama de cada repo del manifiesto materializa este checkout. 'make odoo-verify'
# exige que sea la versión de la imagen o un sufijo suyo.

ADDONS_BRANCH=19.0-stag

# --- Presupuesto de memoria ---
# No son claves de este archivo: son mem_limit en stacks/odoo/compose.yaml y
# stacks/postgres/compose.yaml, fijos. Prueba convive con producción en el mismo
# servidor: bajarlos ahí directo es lo primero que hay que mirar si la RAM aprieta.

# --- Modo del proxy (opcional) ---
# tls es el default: nginx termina TLS con el certificado que emite certbot.

#NGINX_MODE=plain
