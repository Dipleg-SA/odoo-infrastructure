# PRUEBA — `cp .env.staging.example .env` y completar antes de `make up`.
#
# Acá va solo lo que Compose necesita interpolar. Todo lo demás vive en el config
# de su herramienta, bajo stacks/*/config/, y se bootstrapea aparte:
# ver docs/entorno/levantar-staging.md.

# Identidad del stack. Tiene que ser distinto al de producción: conviven en el mismo servidor.
COMPOSE_PROJECT_NAME=staging
COMPOSE_FILE=envs/staging.yaml

# Dominio público de prueba, distinto al de producción.
# No lleva LOCAL_IP: este entorno no publica puertos, entra por el túnel.
PUBLIC_HOSTNAME=

# NO declarar COMPOSE_PROFILES: prueba no lleva dnsmasq, y el 53 no admite un segundo.

# Puertos en loopback, para llegar por túnel SSH. La LAN es de producción.
# Obligatorios: los compose no traen default.
HTTP_PORT=8080
HTTPS_PORT=8443

# Rama de los repos de addons. `make odoo-verify` la exige coherente con la imagen.
ADDONS_BRANCH=19.0-stag

# Modo del proxy. tls es el default; plain es un escape hatch.
#NGINX_MODE=plain

# --- Alertas por mail ---
# odoo NO las usa acá —ODOO_DISABLE_SMTP fuerza smtp_server vacío igual—, pero
# failure-notify.sh sí: cert-renew lleva OnFailure= también en este stack. Los
# mismos cuatro valores de producción, la misma cuenta de ZeptoMail — no hace
# falta un Mail Agent propio para prueba.
SMTP_HOST=smtp.zeptomail.com
SMTP_USER=
#SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
